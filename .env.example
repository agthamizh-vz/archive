# ──────────────────────────────────────────
# ViewZen RAG Chatbot – Environment Config
# ──────────────────────────────────────────

# Google Gemini API Key (required for LLM responses)
GOOGLE_API_KEY=your-gemini-api-key-here

# LLM Model to use
LLM_MODEL=gemini-2.0-flash

# Embedding model (local sentence-transformers model)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=viewzen-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Scraped data paths
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# Chunk settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval settings
TOP_K=5

# API settings
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
